# Assertion memory for OpenAI Codex — add to ~/.codex/config.toml.
#
# Defaults to PROD (memory.assertion-ai.com) and the shared `default` workspace — the
# same tree you use everywhere else.
#
# Key setup — two paths read the key two ways:
#   1. Hooks (capture + inject) read a credentials file (works in CLI and VS Code; GUI
#      hosts don't pass shell env):
#        mkdir -p ~/.assertion && echo '{"api_key":"<your key>"}' > ~/.assertion/credentials.json
#   2. MCP (recall/expand) reads the key from the ASSERTION_API_KEY *environment variable*.
#      Codex's HTTP MCP supports ONLY bearer_token_env_var (a literal `bearer_token` is
#      rejected for streamable_http). Provide the env var:
#        - CLI: `export ASSERTION_API_KEY=...` in the shell you launch codex from.
#        - VS Code: set ASSERTION_API_KEY in the Codex panel's Local-environment UI
#          (env dropdown by the prompt box → Local → gear icon → add the var).

# --- recall / expand tools (MCP) ---------------------------------------------
# Codex's HTTP MCP uses bearer-token auth from an env var (no literal key, no custom
# headers), so the workspace goes in the URL path (/memory/mcp/<workspace>).
[mcp_servers.assertion]
url = "https://memory.assertion-ai.com/memory/mcp/default"
bearer_token_env_var = "ASSERTION_API_KEY"
# Dev override: swap the url to
#   https://auto-insight-product-dev-jbdf42voqq-uc.a.run.app/memory/mcp/<your-dev-workspace>

# --- lifecycle hooks (capture + inject) --------------------------------------
# Preferred: install the plugin (see README) and these come with it — skip this section.
# The inline form below is a no-install fallback. The scripts default to PROD + `default`
# and read the key from ~/.assertion/credentials.json (above). Set ASSERTION_SCRIPTS_DIR
# to the absolute path of ../scripts so the commands resolve.
#
# Dev override: prepend to each command below:
#   ASSERTION_SERVER_URL='https://auto-insight-product-dev-jbdf42voqq-uc.a.run.app' ASSERTION_WORKSPACE='<your-dev-workspace>'

[[hooks.SessionStart]]
matcher = "startup|resume|clear|compact"
[[hooks.SessionStart.hooks]]
type = "command"
command = "python3 \"$ASSERTION_SCRIPTS_DIR/sessionstart_inject.py\""

[[hooks.UserPromptSubmit]]
[[hooks.UserPromptSubmit.hooks]]
type = "command"
command = "python3 \"$ASSERTION_SCRIPTS_DIR/userpromptsubmit_delta.py\""

[[hooks.Stop]]
[[hooks.Stop.hooks]]
type = "command"
command = "python3 \"$ASSERTION_SCRIPTS_DIR/hook_on_stop.py\""
