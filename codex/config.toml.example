# Assertion memory for OpenAI Codex — add to ~/.codex/config.toml.
#
# Defaults to PROD (memory.assertion-ai.com) and the shared `default` workspace — the
# same tree you use everywhere else. You only need ASSERTION_API_KEY.
# To point one machine at dev instead, override locally (see the commented lines).

# --- recall / expand tools (MCP) ---------------------------------------------
# Codex's HTTP MCP only supports bearer-token auth and drops custom headers, so the
# workspace goes in the URL path (/memory/mcp/<workspace>) and the key is sent as
# Authorization: Bearer. `default` is the shared tree.
[mcp_servers.assertion]
url = "https://memory.assertion-ai.com/memory/mcp/default"
bearer_token_env_var = "ASSERTION_API_KEY"
# Dev override: swap the url to
#   https://auto-insight-product-dev-jbdf42voqq-uc.a.run.app/memory/mcp/<your-dev-workspace>

# --- lifecycle hooks (capture + inject) --------------------------------------
# Preferred: install the plugin (see README) and these come with it — skip this section.
# The inline form below is a no-install fallback. The scripts default to PROD + `default`;
# only ASSERTION_API_KEY is required. Set ASSERTION_SCRIPTS_DIR to the absolute path of
# ../scripts so the commands resolve.
#
# Dev override: prepend to each command below:
#   ASSERTION_SERVER_URL='https://auto-insight-product-dev-jbdf42voqq-uc.a.run.app' ASSERTION_WORKSPACE='<your-dev-workspace>'

[[hooks.SessionStart]]
matcher = "startup|resume|clear|compact"
[[hooks.SessionStart.hooks]]
type = "command"
command = "ASSERTION_API_KEY='<your key>' python3 \"$ASSERTION_SCRIPTS_DIR/sessionstart_inject.py\""

[[hooks.UserPromptSubmit]]
[[hooks.UserPromptSubmit.hooks]]
type = "command"
command = "ASSERTION_API_KEY='<your key>' python3 \"$ASSERTION_SCRIPTS_DIR/userpromptsubmit_delta.py\""

[[hooks.Stop]]
[[hooks.Stop.hooks]]
type = "command"
command = "ASSERTION_API_KEY='<your key>' python3 \"$ASSERTION_SCRIPTS_DIR/hook_on_stop.py\""
